{
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "public/**",
        "CommandGenerator/names/**",
        "CommandGenerator/maps/**",
        "CommandGenerator/objects/**",
        "CommandGenerator/CommandGeneratorJP/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
